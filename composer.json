{
    "name": "jiannius/stripe",
    "description": "Jiannius Stripe Wrapper",
    "type": "library",
    "require": {
        "doctrine/dbal": "^3.6|^4.0",
        "stripe/stripe-php": ">=10.0 <18.0",
        "symfony/http-client": "^6.0|^7.0",
        "laravel/pail": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jiannius\\Stripe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jiannius\\Stripe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "authors": [
        {
            "name": "TJ",
            "email": "tj@jiannius.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Jiannius\\Stripe\\StripeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": false,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
